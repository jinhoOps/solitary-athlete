# 설계 단계의 설정 계약입니다. 아직 이 파일을 읽는 실행 코드는 없습니다.
# 복사한 .env 파일은 커밋하지 않습니다. 빈 값에 실제 설정을 넣습니다.

# 수집기 / 명령어 등록 / 삭제 함수의 서버 전용 설정
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_AUTH_CHANNEL_ID=
DISCORD_BOARD_CHANNEL_ID=
DISCORD_NOTICE_CHANNEL_ID=
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_FREE_CHAT_CHANNEL_ID=
DISCORD_FORUM_CHANNEL_ID=

# 역할 ID (관리자, 코치, 회원)
DISCORD_ROLE_ADMIN_ID=
DISCORD_ROLE_COACH_ID=
DISCORD_ROLE_MEMBER_ID=

# 선택: 기본·사진 잔디용 사용자 정의 이모지 ID (둘 다 등록 후 입력)
# 미설정 환경에서는 문자 범례와 기본 이모지로 인증 단계를 구분합니다.
DISCORD_GRASS_RECORD_EMOJI_ID=
DISCORD_GRASS_PHOTO_EMOJI_ID=

# Discord 서명 검증용 공개 키 (서버 설정)
DISCORD_PUBLIC_KEY=

# 서울 리전 공용 프로젝트 github-jinhoOps, 기존 solitary_athlete 스키마 사용
# 이 템플릿은 빈 값으로 유지합니다. 묵묵 테이블·역할은 적용됐고 함수는 미배포입니다.
SUPABASE_URL=

# 앱 전용 mukmuk_worker 역할의 transaction pooler 연결 문자열 (서버 전용)
# 프로젝트 전체 권한의 secret/service-role 키를 대신 넣지 않습니다.
MUKMUK_DATABASE_URL=

# 웹보드의 공개 읽기 설정. 서버 키를 여기에 넣지 않습니다.
SUPABASE_PUBLISHABLE_KEY=

# 웹보드가 배포된 뒤 실제 주소를 입력합니다.
DASHBOARD_URL=

# Supabase Vault 및 삭제 함수에 같은 값으로 저장할 내부 호출 비밀값
# Discord에서 직접 받는 함수에는 이 내부 비밀값 인증을 적용하지 않습니다.
MUKMUK_CLEANUP_SECRET=

# interaction token을 암호화하는 서버 전용 AES-GCM 키 (32바이트 base64)
# Discord 응답 함수와 삭제 함수에서 동일한 키를 사용합니다.
MUKMUK_REPLY_TOKEN_KEY=
